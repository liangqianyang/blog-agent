# 复制为 .env.development（开发）和/或 .env.production（生产）后填写。
# 选择规则：OS 环境变量 > .env.{APP_ENV} > .env > 内置默认值
# 启动：开发直接跑；生产加 APP_ENV=production

# ===== 数据源 =====
# 开发默认打本地 Laravel：详情接口会 +1 浏览量，污染留在本地
BLOG_API_BASE=http://www.blog.test/api

# ===== 对话 LLM（OpenAI 兼容；换服务商只改这三行）=====
CHAT_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CHAT_API_KEY=sk-xxx
CHAT_MODEL=glm-4-flash
CHAT_TEMPERATURE=0.3

# ===== Embedding（OpenAI 兼容 /embeddings；换模型必须重建 Qdrant collection）=====
EMBEDDING_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMS=1024

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=blog_articles
RETRIEVAL_TOP_K=5

# ===== 问答图 =====
MAX_REWRITES=2
MIN_RELEVANT_DOCS=1

# ===== 同步 =====
SYNC_PER_PAGE=50
SYNC_DETAIL_DELAY=0.6

# ===== 服务 =====
DATA_DIR=./data
ADMIN_SYNC_TOKEN=change-me
# 额外允许的 CORS 源（逗号分隔），默认已含 http://localhost:3000
CHAT_CORS_ORIGINS=
